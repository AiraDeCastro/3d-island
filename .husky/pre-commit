set -e

echo "Pre-commit: checking dependency tree..."
npm ls > /dev/null

echo "Pre-commit: linting..."
npm run lint

echo "Pre-commit: type-checking and building..."
npm run build

echo "Pre-commit: auditing dependencies for vulnerabilities..."
npm audit --audit-level=moderate

